# PosePerfect backend settings
HOST=0.0.0.0
PORT=8000
# lite = faster, full = more accurate. Default is lite for smoother live coaching.
POSE_MODEL=lite
MIN_DETECTION_CONFIDENCE=0.5
MIN_PRESENCE_CONFIDENCE=0.5
MIN_TRACKING_CONFIDENCE=0.5
FRAME_TARGET_FPS=6
CORRECT_STABLE_SECONDS=1.2
SCORE_SMOOTHING_WINDOW=8
